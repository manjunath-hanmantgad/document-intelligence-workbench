# ProcureAI

# LLM Provider
# Options: rule-based (no API key required), openai, azure
LLM_PROVIDER=rule-based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (required only for Azure mode)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Database
PROCUREAI_DB_PATH=data/procureai.db

# Policy
PROCUREAI_POLICY_PATH=data/procurement_policy.md

# Approval Matrix
APPROVAL_MATRIX_PATH=data/approval_matrix.yaml

# Server
HOST=127.0.0.1
PORT=8004

# CORS
CORS_ORIGINS=*

# Logging
JSON_LOGS=false
LOG_LEVEL=INFO

# Azure Deployment (placeholders, required only for Azure mode)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
