APP_NAME=Document Intelligence Workbench
APP_ENV=local
LOG_LEVEL=INFO
DASHBOARD_ALLOW_SECRET_PREFILL=false
DOCINT_DATABASE_PATH=storage/docint_workbench.db
DOCINT_DATABASE_BACKEND=sqlite
DOCINT_DATABASE_URL=
LOW_CONFIDENCE_THRESHOLD=0.85
MAX_UPLOAD_CHARS=120000
MAX_UPLOAD_BYTES=8000000
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_SECONDS=5
QUEUE_RETRY_MAX_SECONDS=300
ENABLE_LOCAL_OCR=false
AUTH_ENABLED=true
AUTH_MODE=api_key
REVIEWER_API_KEYS=local-reviewer-key
REVIEWER_ROLE_MAP=local-reviewer-key:ops
REVIEWER_SCOPE_MAP=local-reviewer-key:invoice,contract,unknown
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ALGORITHMS=RS256
OIDC_JWKS_URL=
OIDC_HS256_SHARED_SECRET=
OIDC_ROLE_CLAIM=roles
OIDC_SUBJECT_CLAIM=sub
OIDC_ROLE_SCOPE_MAP=ops:invoice,contract,unknown;finance:invoice;legal:contract;admin:*
ADMIN_TOKEN=local-admin-token
LLM_PROVIDER=deterministic
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Azure-ready placeholders for managed deployment
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EVAL_DEPLOYMENT=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Azure credentials — two options:
# Option A (local dev): fill AZURE_CLIENT_ID + AZURE_CLIENT_SECRET + AZURE_TENANT_ID
# Option B (Azure Container Apps): leave blank — Managed Identity handles auth automatically
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=  # Only needed for local dev. Not used in Azure Container Apps.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=  # Optional when Managed Identity is available.
